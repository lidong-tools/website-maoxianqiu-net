# 复制为 api/.env.local 并在本地/开发环境填写(Vercel 生产环境在后台配置同名变量)
# .local 已被 .gitignore 忽略,不会提交

# Supabase(项目 Settings → API / Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2(存储桶管理 → 管理 R2 API 令牌)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# 可选:上传文件的公开访问地址前缀(绑定 R2 公开域名或 CDN 后填写)
R2_PUBLIC_URL=https://your-public-domain.example.com

# 可选:找回密码邮件里的跳转地址
SUPABASE_RESET_REDIRECT=https://your-domain.com
