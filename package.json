{
  "name": "fantastic-admin",
  "type": "module",
  "version": "6.3.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/cli.ts --mode=dev",
    "dev:api": "tsx scripts/serve-api.ts",
    "dev:web": "pnpm --filter @fantastic-admin/maoxianqiu run dev",
    "dev:all": "run-p dev:web dev:api",
    "build": "tsx scripts/cli.ts --mode=build",
    "serve": "tsx scripts/cli.ts --mode=serve",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:reset": "supabase db reset",
    "db:new-migration": "supabase migration new",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:gen-types": "supabase gen types typescript --project-id $(cat supabase/.temp/project-ref) --schema public > apps/maoxianqiu/src/lib/supabase/types.ts",
    "db:update": "pnpm db:push && pnpm db:gen-types",
    "lint": "run-s lint:tsc lint:eslint lint:stylelint",
    "lint:tsc": "pnpm --filter './apps/*' -r run lint",
    "lint:eslint": "eslint . --cache --fix",
    "lint:stylelint": "stylelint \"{apps,packages}/**/*.{css,scss,vue}\" --cache --fix",
    "check:rpc-manifest": "tsx api/scripts/check-rpc-manifest.ts",
    "check:api-esm": "tsx scripts/check-api-esm.ts",
    "release:preflight": "tsx scripts/release-preflight.ts --strict",
    "release:smoke": "tsx scripts/release-smoke.ts",
    "test:e2e": "pnpm --dir e2e exec playwright test",
    "test:e2e:ui": "pnpm --dir e2e exec playwright test --ui",
    "test:e2e:report": "pnpm --dir e2e exec playwright show-report",
    "preinstall": "npx only-allow pnpm",
    "taze": "taze minor -wIr",
    "commit": "git cz",
    "release": "bumpp"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@clack/prompts": "catalog:",
    "@fantastic-admin/themes": "workspace:*",
    "@hono/node-server": "catalog:",
    "@iconify/json": "catalog:",
    "@playwright/test": "catalog:",
    "@stylistic/stylelint-config": "catalog:",
    "@types/node": "catalog:",
    "@unocss/core": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "autoprefixer": "catalog:",
    "bumpp": "catalog:",
    "cz-git": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all2": "catalog:",
    "simple-git-hooks": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-config-standard-vue": "catalog:",
    "stylelint-scss": "catalog:",
    "taze": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-animations": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
